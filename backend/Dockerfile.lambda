FROM public.ecr.aws/lambda/python:3.12

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR ${LAMBDA_TASK_ROOT}

# Lambda's filesystem is read-only, so compile bytecode at build time into /var/task
COPY pyproject.toml ./
RUN uv pip install --no-cache --compile-bytecode --target "${LAMBDA_TASK_ROOT}" -r pyproject.toml

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

# Default command (overridden by ImageConfig on AI Lambda or backend Lambda)
CMD ["app.lambda_handler.handler"]
